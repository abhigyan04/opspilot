# Runtime defaults. Native Python reads process environment variables only:
# copying this file to .env does not load it into Python automatically.
# PowerShell example: $env:OPSPILOT_INVESTIGATION_MODEL = "qwen3:8b"
# Docker Compose reads .env for the explicitly forwarded variables below.

OPSPILOT_INVESTIGATION_MODEL=qwen3:4b
# Standalone agent diagnosis and evaluation CLI default:
OPSPILOT_DIAGNOSIS_MODEL=qwen3:4b
# Web API and workflow CLI diagnosis default:
OPSPILOT_WORKFLOW_DIAGNOSIS_MODEL=qwen3:8b
OPSPILOT_SERVICE=checkout-service
OPSPILOT_MAX_STEPS=6
OPSPILOT_WORKFLOW_NUM_CTX=8192
OPSPILOT_WORKFLOW_NUM_PREDICT=2048

# Native Ollama default. Compose uses host.docker.internal instead.
# OLLAMA_HOST=http://localhost:11434
